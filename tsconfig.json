{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "paths": {
      "@framework/*": ["./src/framework/*"]
    },
    "types": ["node", "cypress"]
  },
  "include": ["cypress/**/*.ts", "src/**/*.ts", "cypress.config.ts"],
  "exclude": ["node_modules"]
}
